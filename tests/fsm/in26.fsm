0 -> 1 'a' .. 'c', 'x', "0" .. "9";
0 -> 2 "\x00" .. "\x1f", "\x7f" .. "\xff";

# overlapping and adjacent ranges
1 -> 2 'a' .. 'm', 'g' .. 'z', '{' .. '}';

2 -> 3 "\101" .. 'C', "\\", 'm' .. "m";

start: 0;
end: 3;

